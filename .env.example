# Copy to .env and edit to change what gets downloaded and where it lives.
# Every value here except MAPS_POSTGRES_PASSWORD is also the default.

# Where downloaded data and built graphs are stored
MAPS_DATA_DIR=./maps_data

# Which release of the app's images (owenelliottdev/navcat-*) to run, e.g. 1.2.0
MAPS_TAG=latest

# For development: build the app's images from this checkout instead of pulling them
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# ---------- Map, search and street routing ----------

# OSM extract read by GraphHopper (routing), Planetiler (map tiles) and browse
OSM_URL=https://download.geofabrik.de/australia-oceania/australia-latest.osm.pbf
OSM_FILE=australia.osm.pbf

# Places from Overture Maps (businesses and the like that OSM doesn't have yet), downloaded with
# the OSM extract and merged into browse and search. Only places whose address is in one of
# these countries (ISO codes, space separated) are kept; leave it empty to keep everything in
# the extract's bounding box. Set OVERTURE_PLACES=false to use OSM's places only.
OVERTURE_PLACES=true
OVERTURE_COUNTRIES=AU

# Planetiler area name (for its coastline/lake downloads) and output file
TILES_AREA=australia
TILES_FILE=australia.mbtiles

# Photon search index region (see https://github.com/rtuszik/photon-docker)
PHOTON_REGION=australia-oceania

# Memory for serving routes, and for building the routing graph (setup and map updates)
GRAPHHOPPER_MEMORY=3g
GRAPHHOPPER_IMPORT_MEMORY=8g

# ---------- Public transport (OpenTripPlanner) ----------

# Street map for walking to and from stops. Left empty, it's cut from the OSM extract above,
# around the timetables' stops (OTP needs far more memory per km² than GraphHopper, so it
# only gets the area with public transport). Set a URL to download a different one.
TRANSIT_OSM_URL=

# GTFS timetables, space separated. A zip of GTFS zips (like PTV's) is unpacked. The defaults
# are every state that publishes them without an API key: Victoria (PTV), south-east Queensland
# (Translink), Adelaide Metro and Transperth. OTP plans in one time zone, so feeds in others are
# shifted into it by today's difference when downloaded; where they differ on daylight saving
# (Queensland and WA don't have it), trips after the next clock change are an hour out until
# the next ./maps update transit (./maps schedule on does it weekly).
TRANSIT_GTFS_URLS=https://data.ptv.vic.gov.au/downloads/gtfs.zip https://gtfsrt.api.translink.com.au/GTFS/SEQ_GTFS.zip https://gtfs.adelaidemetro.com.au/v1/static/latest/google_transit.zip https://www.transperth.wa.gov.au/TimetablePDFs/GoogleTransit/Production/google_transit.zip

# Memory for building the graph (one-off) and for serving it
OTP_BUILD_MEMORY=8g
OTP_MEMORY=5g

# ---------- Accounts and browse (Postgres + PostGIS) ----------

# Required. Only the backend and POI import use it; the database isn't published.
MAPS_POSTGRES_PASSWORD=change-me

# Let anyone create an account. Set to false once you've made yours.
ALLOW_SIGNUP=true

# How long you stay signed in
SESSION_DAYS=30

# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# ---------- Automatic updates (./maps schedule on) ----------

# When to update, in cron syntax (minute hour day-of-month month day-of-week), in TZ's local
# time. Timetables change most often and run out, so they're weekly; the map and search
# index monthly. Leave one empty to not update it automatically.
TZ=Australia/Melbourne
UPDATE_TRANSIT_SCHEDULE=0 3 * * 1
UPDATE_MAP_SCHEDULE=0 4 1 * *
