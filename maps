#!/bin/sh
# Sets up, updates and checks on Nav Cat's data.
#
#   ./maps setup             Downloads and builds anything missing, then starts the stack
#   ./maps update [what...]  Refreshes data on the running stack. what is any of:
#                              map      the OSM extract, and the tiles, routing and POIs from it
#                              places   only the Overture places
#                              routing  the routing graph, e.g. after changing its config
#                              transit  public transport timetables
#                              search   the search index
#                              all      everything above (the default)
#   ./maps status            How old each piece of data is
#   ./maps schedule on|off   Runs updates on the schedules in .env
#   ./maps dev [command]     Runs a command (setup if none) with images built from this
#                            checkout, e.g. ./maps dev update routing
#
# Updates build new data alongside the old and swap it in, so each service only stops to
# restart. With under 20 GB of memory for Docker, public transport (and for a routing build,
# routing) stops while the large builds run.
set -eu
cd "$(dirname "$0")"

LOW_MEMORY_BYTES=$((20 * 1024 * 1024 * 1024))

compose() { docker compose "$@"; }

# Pulls the published images and builds any that docker-compose.dev.yml builds (all services,
# or the named ones)
get_images() {
  # Named explicitly, as --profile flags replace the profiles .env turns on (e.g. mcp)
  if [ $# -eq 0 ]; then
    set -- $({
      compose --profile setup --profile updates config --services
      compose config --services
    } | sort -u)
  fi
  compose --profile setup --profile updates --ignore-buildable "$@"
  compose --profile setup --profile updates build "$@"
}

log() { printf '\n==> %s %s\n' "$(date +%H:%M:%S)" "$*"; }

# Runs a shell command in the data folder (maps-data). Single-quote it so variables like
# $OSM_FILE expand in the container, from .env.
in_data() { compose run --rm --no-deps maps-data "$1"; }
data_has() { in_data "test -e $1" >/dev/null 2>&1; }

is_running() { [ -n "$(compose ps -q --status running "$1")" ]; }

low_memory() { [ "$(docker info --format '{{.MemTotal}}')" -lt "$LOW_MEMORY_BYTES" ]; }

# Runs a memory-hungry build, pausing public transport around it when memory is short.
# Leaves $paused set if it did.
heavy() {
  paused=""
  if low_memory && is_running maps-otp; then
    echo "Pausing public transport while this builds (Docker has under 20 GB of memory)"
    compose stop maps-otp
    paused=1
  fi
  result=0
  "$@" || result=$?
  if [ -n "$paused" ]; then compose start maps-otp; fi
  return "$result"
}

# A new maps-graphhopper image with other profiles or encoded values can't serve the old graph.
# The import stores the image's config fingerprint with the graph (graphhopper.sh).
routing_config_changed() {
  data_has graphhopper/default-gh && ! compose run --rm --no-deps --entrypoint sh maps-graphhopper \
    -c 'cmp -s graph-config.sha /data/default-gh/graph-config.sha' >/dev/null 2>&1
}

# OTP only loads a graph saved by its own serialization version
transit_graph_outdated() {
  data_has transit/graph.obj || return 1
  image_id=$(compose run --rm --no-deps maps-otp --version 2>/dev/null |
    sed -n 's/.*ser\.ver\.id: 0*\([0-9]*\).*/\1/p')
  graph_id=$(in_data 'head -c 29 transit/graph.obj | cut -d ";" -f 2' 2>/dev/null |
    tr -dc 0-9 | sed 's/^0*//')
  [ -n "$image_id" ] && [ "$image_id" != "$graph_id" ]
}

# With "reuse", skips extracts already downloaded from the same URL
download_map() {
  log "Downloading OSM map data, elevation and Overture places"
  reuse=""
  if [ "${1:-}" = reuse ]; then reuse=true; fi
  compose run --rm -e "OSM_REUSE=$reuse" maps-download
}

download_places() {
  log "Downloading Overture places"
  compose run --rm maps-download places
}

# GraphHopper only downloads the elevation files its roads cross; the terrain needs them all
download_elevation() {
  log "Downloading any missing elevation data"
  compose run --rm maps-download elevation
}

# Skips the build unless the elevation files changed
build_terrain() {
  log "Building terrain for the topo map"
  compose run --rm --no-deps -e WAIT_FOR= maps-terrain-build
}

import_pois() {
  log "Importing places for browse and search"
  compose run --rm maps-poi-import
}

run_planetiler() {
  log "Building map tiles"
  compose run --rm maps-planetiler
}

run_graphhopper_import() {
  log "Building the routing graph (about 20 minutes for Australia)"
  compose run --rm maps-graphhopper-import
}

run_otp_build() {
  log "Building the public transport graph"
  compose run --rm maps-otp-build
}

# Planetiler builds into another file, which replaces the old tiles once it's finished
build_tiles() {
  export TILES_BUILD_FILE=building.mbtiles
  heavy run_planetiler || { unset TILES_BUILD_FILE; return 1; }
  unset TILES_BUILD_FILE
  in_data 'mv tiles/building.mbtiles "tiles/$TILES_FILE"'
  if is_running maps-tileserver; then compose restart maps-tileserver; fi
}

# GraphHopper builds into default-gh.new, which replaces default-gh once it's finished
build_routing() {
  in_data 'rm -rf graphhopper/default-gh.new'
  export GRAPHHOPPER_GRAPH=default-gh.new
  stopped=""
  if low_memory && is_running maps-graphhopper; then
    echo "Stopping routing while this builds (Docker has under 20 GB of memory)"
    compose stop maps-graphhopper
    stopped=1
  fi
  result=0
  heavy run_graphhopper_import || result=$?
  unset GRAPHHOPPER_GRAPH
  if [ "$result" != 0 ]; then
    in_data 'rm -rf graphhopper/default-gh.new'
    if [ -n "$stopped" ]; then compose start maps-graphhopper; fi
    return "$result"
  fi

  log "Swapping in the new routing graph"
  compose stop maps-graphhopper
  in_data 'rm -rf graphhopper/default-gh.old
    if [ -e graphhopper/default-gh ]; then mv graphhopper/default-gh graphhopper/default-gh.old; fi
    mv graphhopper/default-gh.new graphhopper/default-gh'
  compose up -d --wait maps-graphhopper
  in_data 'rm -rf graphhopper/default-gh.old'
  # The speed limit and bike lane overlays are cached from the old graph
  if is_running maps-web; then
    compose exec -T maps-web sh -c 'rm -rf /var/cache/nginx/road-data/*'
  fi
}

download_transit() {
  log "Downloading public transport timetables"
  compose run --rm maps-transit-download
}

# OTP writes graph.obj in place, so the old one is moved aside and restored if the build fails
build_transit() {
  in_data 'if [ -e transit/graph.obj ]; then mv transit/graph.obj transit/graph.obj.old; fi'
  if ! heavy run_otp_build; then
    in_data 'if [ -e transit/graph.obj.old ]; then mv transit/graph.obj.old transit/graph.obj; fi'
    return 1
  fi
  in_data 'rm -f transit/graph.obj.old'
  # If heavy paused OTP, it already restarted on the new graph
  if [ -z "$paused" ] && is_running maps-otp; then compose restart maps-otp; fi
}

# A second Photon downloads the new index into photon.new; once it's serving, the folders are
# swapped and the real one restarts on the new index
update_search() {
  log "Downloading a new search index"
  in_data 'rm -rf photon.new'
  docker rm -f navcat-photon-update >/dev/null 2>&1 || true
  export PHOTON_DATA_DIR=photon.new
  compose run -d --no-deps --name navcat-photon-update maps-photon >/dev/null
  unset PHOTON_DATA_DIR
  until docker exec navcat-photon-update curl -sf localhost:2322/status >/dev/null 2>&1; do
    if [ -z "$(docker ps -q --filter name=navcat-photon-update)" ]; then
      echo "Downloading the search index failed:"
      docker logs --tail 20 navcat-photon-update
      docker rm -f navcat-photon-update >/dev/null
      in_data 'rm -rf photon.new'
      return 1
    fi
    sleep 30
  done
  docker rm -f navcat-photon-update >/dev/null

  log "Swapping in the new search index"
  compose stop maps-photon
  in_data 'rm -rf photon.old && mv photon photon.old && mv photon.new photon'
  compose up -d maps-photon
  in_data 'rm -rf photon.old'
}

setup() {
  log "Getting images"
  get_images

  # A new extract means rebuilding the tiles and routing graph made from the old one
  new_map=""
  if ! data_has 'osm/$OSM_FILE'; then
    download_map reuse
    new_map=1
  elif ! compose run --rm maps-download check; then
    echo "OSM_URL has changed since the map data was downloaded"
    download_map reuse
    new_map=1
  else
    download_elevation
    if ! data_has 'osm/${OSM_FILE%.osm.pbf}.places.csv.gz'; then
      download_places
    fi
  fi
  if ! data_has 'tiles/$TILES_FILE'; then
    run_planetiler
  elif [ -n "$new_map" ]; then
    build_tiles
  fi
  if ! data_has graphhopper/default-gh; then
    run_graphhopper_import
  elif [ -n "$new_map" ]; then
    build_routing
  elif routing_config_changed; then
    echo "The routing config has changed since the graph was built"
    build_routing
  fi
  if ! in_data 'ls transit/*gtfs*.zip' >/dev/null 2>&1; then
    download_transit
  fi
  if ! data_has transit/graph.obj; then
    run_otp_build
  elif transit_graph_outdated; then
    echo "The public transport graph was built by another version of OTP"
    build_transit
  fi

  log "Starting everything"
  compose up -d
  echo
  echo "Done: open http://localhost:7000"
  echo "Search downloads its index on first start, so it may take a few minutes to start working."
}

update() {
  what="${*:-all}"
  if [ "$what" = all ]; then what="map transit search"; fi

  for part in $what; do
    case "$part" in
      map | places | routing | transit | search) ;;
      *) echo "Unknown update: $part (map, places, routing, transit, search or all)" >&2; exit 2 ;;
    esac
  done

  # One update at a time (e.g. a scheduled one and one run by hand)
  if ! mkdir .update.lock 2>/dev/null; then
    echo "Another update is running. If it isn't, remove the .update.lock folder." >&2
    exit 1
  fi
  trap 'rmdir .update.lock' EXIT

  # These images hold the download and import scripts and the routing profiles
  get_images maps-download maps-db maps-graphhopper maps-terrain-build
  case " $what " in
    *" map "* | *" routing "*) ;;
    *) if routing_config_changed; then
      echo "The routing config has changed since the graph was built, so routing updates too"
      what="$what routing"
    fi ;;
  esac
  case " $what " in
    *" transit "*) ;;
    *) if transit_graph_outdated; then
      echo "The public transport graph was built by another version of OTP, so transit updates too"
      what="$what transit"
    fi ;;
  esac

  # A part that fails is reported, and the rest still update
  failed=""
  for part in $what; do
    case "$part" in
      map) download_map && build_tiles && import_pois && build_routing && build_terrain ;;
      places) download_places && import_pois ;;
      routing) build_routing ;;
      transit) download_transit && build_transit ;;
      search) update_search ;;
    esac || failed="$failed $part"
  done

  if [ -n "$failed" ]; then
    log "Failed to update:$failed (still using the previous data)"
    exit 1
  fi
  log "Updated: $what"
}

usage() {
  # The comment at the top of this file
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
}

schedule() {
  case "${1:-}" in
    on)
      export MAPS_PROJECT_DIR="$PWD"
      get_images maps-updater
      compose --profile updates up -d maps-updater
      compose logs maps-updater | tail -n 3
      ;;
    off) compose --profile updates rm -sf maps-updater ;;
    *) echo "Usage: ./maps schedule on|off" >&2; exit 2 ;;
  esac
}

main() {
  command="${1:-}"
  [ $# -gt 0 ] && shift
  case "$command" in
    setup) setup ;;
    update) update "$@" ;;
    status) in_data 'python3 /status.py' 2>/dev/null ;;
    schedule) schedule "$@" ;;
    dev)
      export COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
      if [ $# -eq 0 ]; then set -- setup; fi
      main "$@"
      ;;
    -h | --help | help | "") usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
