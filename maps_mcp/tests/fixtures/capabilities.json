    "avoid": [
      { "id": "motorways", "priority": [{ "if": "road_class == MOTORWAY", "multiply_by": "0.1" }] },
      { "id": "tolls", "priority": [{ "if": "toll == ALL", "multiply_by": "0.1" }] },
      {
        "id": "traffic_lights",
        "priority": [{ "if": "crossing == TRAFFIC_SIGNALS", "multiply_by": "0.4" }]
      }
    ],
    "steepHills": {
      "priority": [
        { "if": "max_slope >= 12 || max_slope <= -12", "multiply_by": "0.05" },
        { "else_if": "max_slope >= 8 || max_slope <= -8", "multiply_by": "0.2" },
        { "else_if": "max_slope >= 5 || max_slope <= -5", "multiply_by": "0.6" }
      ]
    }
  },
  "transit": {
    "modes": ["BUS", "TRAM"],
    "timetablesFrom": "2026-04-25",
    "timetablesUntil": "2028-01-27"
  }
